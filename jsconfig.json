{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "checkJs": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "#config/*": ["src/config/*"],
      "#data/*": ["src/data/*"],
      "#pages/*": ["src/pages/*"],
      "#flows/*": ["src/flows/*"]
    }
  },
  "include": ["src/**/*.js", "tests/**/*.js", "playwright.config.js"]
}
