{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "checkJs": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["src/pages/*"],
      "@fixtures/*": ["src/fixtures/*"],
      "@helpers/*": ["src/helpers/*"],
      "@api/*": ["src/api/*"],
      "@data/*": ["src/data/*"],
      "@types/*": ["src/types/*"],
      "@config/*": ["config/*"],
      "@test-data/*": ["test-data/*"]
    }
  },
  "include": ["src/**/*.js", "tests/**/*.js", "config/**/*.js", "playwright.config.js"]
}
